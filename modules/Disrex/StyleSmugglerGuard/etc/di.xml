<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Entry: sanitise the styles value before the email template renders. -->
    <type name="Magento\Email\Model\AbstractTemplate">
        <plugin name="Disrex_StyleSmugglerGuard_TemplateStylesSanitizer"
                type="Disrex\StyleSmugglerGuard\Plugin\TemplateStylesSanitizerPlugin"/>
    </type>

    <!-- Plumbing: reject {{block}} directives naming DI/Setup/Code namespaces. -->
    <type name="Magento\Framework\Filter\Template">
        <plugin name="Disrex_StyleSmugglerGuard_BlockDirectiveAllowlist"
                type="Disrex\StyleSmugglerGuard\Plugin\BlockDirectiveAllowlistPlugin"/>
    </type>

    <!-- Stage 1: strip PHP tags from the store-not-found message before it is logged. -->
    <type name="Magento\Store\Model\StoreManager">
        <plugin name="Disrex_StyleSmugglerGuard_LogPoisonHygiene"
                type="Disrex\StyleSmugglerGuard\Plugin\LogPoisonHygienePlugin"/>
    </type>

    <!-- Optional trigger containment, DEFAULT OFF. -->
    <type name="Magento\Sales\Model\Service\PaymentFailuresService">
        <plugin name="Disrex_StyleSmugglerGuard_PaymentFailureContainment"
                type="Disrex\StyleSmugglerGuard\Plugin\PaymentFailureContainmentPlugin"/>
    </type>
</config>
